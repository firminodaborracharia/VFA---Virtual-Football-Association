# ─────────────────────────────────────────────────────────────
# VFA — Virtual Football Association
# Copie este arquivo para .env.local e preencha os valores.
# NUNCA versione .env.local — ele contém segredos.
# ─────────────────────────────────────────────────────────────

# ── Banco de dados ───────────────────────────────────────────
# Supabase: Project Settings → Database → Connection string (URI)
# Neon:     Dashboard → Connection Details → Pooled connection
# Use a string COM pooler para a aplicação.
DATABASE_URL="postgresql://usuario:senha@host:5432/vfa?sslmode=require"

# ── Auth.js ──────────────────────────────────────────────────
# Gere com:  npx auth secret
AUTH_SECRET=""

# ── Discord OAuth2 ───────────────────────────────────────────
# 1. Acesse https://discord.com/developers/applications
# 2. New Application → dê o nome "VFA"
# 3. Aba OAuth2 → copie o Client ID e o Client Secret
# 4. Em "Redirects", adicione EXATAMENTE:
#      http://localhost:3000/api/auth/callback/discord
#      https://SEU-DOMINIO/api/auth/callback/discord
AUTH_DISCORD_ID=""
AUTH_DISCORD_SECRET=""

# ── Primeiro administrador ───────────────────────────────────
# Seu ID numérico do Discord (Configurações → Avançado → Modo desenvolvedor,
# depois clique com o botão direito no seu perfil → "Copiar ID do usuário").
# Aceita vários, separados por vírgula. Quem estiver nesta lista vira ADMIN
# automaticamente ao fazer login. Depois disso, use o painel /admin/usuarios.
BOOTSTRAP_ADMIN_DISCORD_IDS=""

# ── URL pública do site ──────────────────────────────────────
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ── Envio de imagens (opcional) ────────────────────────────────
#
# Sem estas variáveis o painel continua funcionando: os campos de imagem
# aceitam um endereço colado. Preenchendo, aparece também o botão "Enviar"
# para escolher um arquivo do computador.
#
# Onde conseguir, no Supabase:
#   1. Storage → New bucket → nome "vfa-public" → marque "Public bucket".
#   2. Project Settings → API keys → copie a chave "service_role".
#
# A service_role ignora todas as regras de acesso do projeto. Ela NUNCA pode
# aparecer no navegador, e por isso não tem o prefixo NEXT_PUBLIC_. O código
# que a usa é marcado como "server-only": se algum componente de cliente
# tentar importá-lo, o build falha em vez de vazar a chave.
SUPABASE_SERVICE_ROLE_KEY=

# Deduzida da DATABASE_URL quando o banco é do Supabase. Preencha apenas se
# você usa outro banco e o Storage do Supabase separadamente.
SUPABASE_URL=

# Só se você criou o bucket com outro nome.
SUPABASE_STORAGE_BUCKET=vfa-public
