# ─────────────────────────────────────────────────────────────
# VFA — Virtual Football Association
# Copie este arquivo para .env.local e preencha os valores.
# NUNCA versione .env.local — ele contém segredos.
# ─────────────────────────────────────────────────────────────

# ── Banco de dados ───────────────────────────────────────────
# Supabase: Project Settings → Database → Connection string (URI)
# Neon:     Dashboard → Connection Details → Pooled connection
# Use a string COM pooler para a aplicação.
DATABASE_URL="postgresql://usuario:senha@host:5432/vfa?sslmode=require"

# ── Auth.js ──────────────────────────────────────────────────
# Gere com:  npx auth secret
AUTH_SECRET=""

# ── Discord OAuth2 ───────────────────────────────────────────
# 1. Acesse https://discord.com/developers/applications
# 2. New Application → dê o nome "VFA"
# 3. Aba OAuth2 → copie o Client ID e o Client Secret
# 4. Em "Redirects", adicione EXATAMENTE:
#      http://localhost:3000/api/auth/callback/discord
#      https://SEU-DOMINIO/api/auth/callback/discord
AUTH_DISCORD_ID=""
AUTH_DISCORD_SECRET=""

# ── Primeiro administrador ───────────────────────────────────
# Seu ID numérico do Discord (Configurações → Avançado → Modo desenvolvedor,
# depois clique com o botão direito no seu perfil → "Copiar ID do usuário").
# Aceita vários, separados por vírgula. Quem estiver nesta lista vira ADMIN
# automaticamente ao fazer login. Depois disso, use o painel /admin/usuarios.
BOOTSTRAP_ADMIN_DISCORD_IDS=""

# ── URL pública do site ──────────────────────────────────────
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
